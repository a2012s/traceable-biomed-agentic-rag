# ============ 模型接入 ============
# 支持三家 OpenAI 兼容端点，任选其一填 KEY 即可切到真实模型；留空则自动用 MockLLM。
# 可选值: openai | deepseek | dashscope | mock
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 分层路由：编排与最终生成用 STRONG_MODEL，查询重写用 CHEAP_MODEL
# 两者留空时均复用当前 provider 的主模型。若主模型是推理型（如 qwen4-max-preview），
# 强烈建议把 CHEAP_MODEL 设为非推理模型（如 qwen-plus），否则重写节点会显著拖慢整体延迟。
STRONG_MODEL=
CHEAP_MODEL=

# ============ Embedding / 向量库 ============
# embedding_backend: hash(零依赖) | tfidf(离线真向量,默认) | api(真 embedding 模型)
# api 模式需 API key，用下方 /embeddings 端点；失败自动降级 tfidf
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=text-embedding-v3
# vector_store: qdrant(本地 HNSW) | numpy(内存暴力检索)
# qdrant 需装可选依赖: uv pip install -e ".[real-vector]"
VECTOR_STORE=qdrant
# 默认 :memory: —— 真 HNSW 但不落盘、无文件锁；需要跨进程复用索引时改成 .qdrant_data
QDRANT_PATH=:memory:

# ============ 检索 / 编排 ============
RERANK_TOP_K=5
RETRIEVE_TOP_K=50
# 跨域融合后送入生成节点的证据条数
EVIDENCE_TOP_K=8
MAX_REFLECTIONS=2
# 1=全量并行召回四个数据域（默认，召回优先）；0=由编排器按领域裁剪（省资源、掉召回）
WIDE_RECALL=1

# ============ 观测 ============
# 1=额外打印决策链实时日志（stdout 已有一份表格，默认关）
VERBOSE=0

# ============ 生产化（默认值保持离线 Demo 行为）============
# 检查点：memory(默认) | sqlite(需 uv pip install -e ".[production]")
CHECKPOINTER=memory
CHECKPOINT_DB=.agentic_rag.db
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_S=120
# 答案缓存 TTL 秒；0=关闭。键含语料版本+检索配置+模型档位
ANSWER_CACHE_TTL_S=300
# 外部 cross-encoder：POST {url} {query,text} -> {"score": 0~1}；留空用内置打分
RERANKER_API_URL=
RERANKER_API_KEY=
# 实体链接（eGFR/EGFR 同形异义降权），默认开
ENTITY_LINKING=1
# 反馈闭环：默认关；开启写本地 SQLite（只存问题哈希，不存原文）
FEEDBACK_ENABLED=0
FEEDBACK_DB=.agentic_rag_feedback.db
