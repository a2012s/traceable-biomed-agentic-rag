# ============ 模型接入 ============
# 支持三家 OpenAI 兼容端点，任选其一填 KEY 即可切到真实模型；留空则自动用 MockLLM。
# 可选值: openai | deepseek | dashscope | mock
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 分层路由：编排与最终生成用 STRONG_MODEL，查询重写用 CHEAP_MODEL
# 两者留空时均复用当前 provider 的主模型。若主模型是推理型（如 qwen4-max-preview），
# 强烈建议把 CHEAP_MODEL 设为非推理模型（如 qwen-plus），否则重写节点会显著拖慢整体延迟。
STRONG_MODEL=
CHEAP_MODEL=

# ============ Embedding / 向量库 ============
# embedding_backend: hash(零依赖) | tfidf(离线真向量,默认) | api(真 embedding 模型)
# api 模式需 API key，用下方 /embeddings 端点；失败自动降级 tfidf
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=text-embedding-v3
# api 模式每批送多少条文本（一次送全部会撞单请求上限）
EMBEDDING_BATCH_SIZE=64
# 1=embedding API 失败直接报错，不静默降级（生产建议开）
EMBEDDING_STRICT=0
# vector_store: qdrant(本地 HNSW) | numpy(内存暴力检索)
# qdrant 需装可选依赖: uv pip install -e ".[real-vector]"
VECTOR_STORE=qdrant
# 默认 :memory: —— 真 HNSW 但不落盘、无文件锁；需要跨进程复用索引时改成 .qdrant_data
QDRANT_PATH=:memory:

# ============ 检索 / 编排 ============
RERANK_TOP_K=5
RETRIEVE_TOP_K=50
# 送入重排的候选上限（只对前 N 条重排，深位候选不会进证据窗口）
RERANK_CANDIDATES=20
# 跨域融合后送入生成节点的证据条数
EVIDENCE_TOP_K=8
# 融合截断：保留最佳分数的 FUSE_MARGIN 倍以上，但至少留 FUSE_MIN_KEEP 条
# 保底为 2 可消除"最佳项离群→只剩 1 条→Critic 必然不通过→反复反思仍拒答"
FUSE_MARGIN=0.5
FUSE_MIN_KEEP=2
# RRF 平滑常数
RRF_K=60
MAX_REFLECTIONS=2
# 单请求 token 预算：超过即停止反思，避免证据枯竭的查询空转烧钱
MAX_TOKENS_PER_REQUEST=20000
# 1=全量并行召回四个数据域（默认，召回优先）；0=由编排器按领域裁剪（省资源、掉召回）
WIDE_RECALL=1

# ============ 观测 ============
# 1=额外打印决策链实时日志（stdout 已有一份表格，默认关）
VERBOSE=0

# ============ 生产化（默认值保持离线 Demo 行为）============
# 检查点：memory(默认) | sqlite(需 uv pip install -e ".[production]")
CHECKPOINTER=memory
CHECKPOINT_DB=.agentic_rag.db
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_S=120
# 答案缓存 TTL 秒；0=关闭。键含语料版本+检索配置+模型档位
ANSWER_CACHE_TTL_S=300
# 外部 cross-encoder：POST {url} {query, texts} -> {"scores": [...]}；留空用内置打分。
# 兼容单条端点 {query, text} -> {score}（texts 长度为 1 时）。
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_TIMEOUT_S=3
RERANKER_BREAKER_COOLDOWN_S=60
# 1=向量集合维度变化时允许自动重建；默认 0，避免改一行配置就静默删索引
ALLOW_REINDEX=0
# 实体链接（eGFR/EGFR 同形异义降权），默认开
ENTITY_LINKING=1

# ============ Agent 能力 ============
# 1=LLM 自主工具选择：模型看工具 JSON Schema 决定调哪个、传什么参数，结果进证据链
TOOL_USE_ENABLED=1
# 单轮最多接受几个工具调用（防一次塞十几个调用打爆延迟与上下文）
TOOL_USE_MAX_CALLS=3
# 1=Human-in-the-loop：Critic 判证据不足时中断，等人工决定后续跑
# 默认关：eval.py/批处理无人值守，中断会让进程停在等人这一步；Web 演示加 HITL_ENABLED=1 开启
HITL_ENABLED=0
# 单次请求最多中断几次，>1 会让用户被反复弹窗打断
HITL_MAX_REVIEWS=1
# 反馈闭环：默认关；开启写本地 SQLite（只存问题哈希，不存原文）
FEEDBACK_ENABLED=0
FEEDBACK_DB=.agentic_rag_feedback.db
